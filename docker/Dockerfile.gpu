FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu20.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MAMBA_ROOT_PREFIX=/opt/conda

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl bzip2 build-essential git \
    libglib2.0-0 libgl1 libx11-6 \
 && rm -rf /var/lib/apt/lists/*

RUN curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest \
    | tar -xvj -C /usr/local/bin --strip-components=1 bin/micromamba

RUN useradd -m -u 1000 appuser && mkdir -p /app && chown -R appuser:appuser /app

WORKDIR /app

RUN micromamba create -y -n bulletarm python=3.7.16 && \
    micromamba clean --all --yes

SHELL ["bash", "-lc"]

RUN micromamba run -n bulletarm python -m pip install --upgrade pip && \
    micromamba run -n bulletarm pip install \
      torch==1.13.1+cu117 torchvision==0.14.1+cu117 torchaudio==0.13.1 \
      --extra-index-url https://download.pytorch.org/whl/cu117

COPY requirements.txt /app/requirements.txt
RUN if [ -s /app/requirements.txt ]; then \
      micromamba run -n bulletarm pip install -r /app/requirements.txt ; \
    fi


COPY . /app

RUN chown -R appuser:appuser /app /opt/conda
USER appuser

RUN chmod +x /app/docker/entrypoint.sh
ENTRYPOINT ["/app/docker/entrypoint.sh"]

CMD []